# =====================================================================
# Digital Dark Spot - Environment Configuration Template
# Copy this file to .env and provide your credentials as needed.
# Note: The platform includes built-in fallback modes and transparent
# sample data, so you can test the entire workflow immediately.
# =====================================================================

# ---------------------------------------------------------------------
# AI Engine: Google Gemini API
# Get your API key at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# Database & Authentication: Firebase Admin SDK
# Generate service account credentials in Firebase Console > Project Settings > Service Accounts
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------
# Backend Server Configuration
# ---------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
DEBUG=True

# ---------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# Prefix with VITE_ for Vite to expose variables to the browser
# ---------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
